# Copie este arquivo para .streamlit/secrets.toml no ambiente local.
# Nunca envie secrets.toml para o GitHub.
@'
GROQ_API_KEY = "SUA_CHAVE_GROQ_AQUI"
GROQ_MODEL = "openai/gpt-oss-20b"

SUPABASE_URL = "https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY = "SUA_CHAVE_PUBLICA_SUPABASE"
'@ | Set-Content -Encoding utf8 .streamlit\secrets.toml.example
